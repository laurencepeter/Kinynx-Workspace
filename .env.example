# ─── Kinynx environment ─────────────────────────────────────────────────────
# Copy to `.env` and adjust. NEVER commit a real .env.

# Deployment edition is derived from the license, not set here.
NODE_ENV=development
API_PORT=4000
PUBLIC_APP_URL=http://localhost

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=kinynx
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=kinynx
DATABASE_URL=postgres://kinynx:change-me-in-production@postgres:5432/kinynx

# ─── Redis (cache / jobs / realtime fan-out) ────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=2592000     # seconds (30 days)

# ─── Object storage ─────────────────────────────────────────────────────────
# Default is `local` (filesystem, persisted in the `uploads` volume) — no
# external image needed. For S3-compatible storage set STORAGE_DRIVER=s3 and
# the S3_* vars below, then either run the bundled MinIO
# (`docker compose --profile minio up -d`) or point S3_ENDPOINT at AWS S3 /
# Cloudflare R2. The bucket is auto-created on boot if the credentials allow it.
STORAGE_DRIVER=local          # local | s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=kinynx
S3_ACCESS_KEY=kinynx
S3_SECRET_KEY=change-me-in-production
S3_FORCE_PATH_STYLE=true

# ─── Licensing (Enterprise) ─────────────────────────────────────────────────
# Path to an uploaded license file for self-hosted Enterprise. Optional.
# If absent or invalid, Kinynx runs as Community Edition (never disabled).
KINYNX_LICENSE_FILE=
# Public key used to verify license signatures (Ed25519, base64). Optional.
KINYNX_LICENSE_PUBLIC_KEY=

# ─── Email (invites, notifications) ─────────────────────────────────────────
# console = log to stdout (default, zero-config). smtp = any provider. mailjet = REST API.
EMAIL_DRIVER=console
EMAIL_FROM=Kinynx <no-reply@kinynx.local>
# SMTP works with Mailjet, SendGrid, Postmark, Amazon SES, Mailgun, Gmail, etc.
#   Mailjet:  SMTP_HOST=in-v3.mailjet.com  SMTP_PORT=587  SMTP_USER=<API key>  SMTP_PASS=<secret key>
#   SendGrid: SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey     SMTP_PASS=<api key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Or use the Mailjet REST API instead of SMTP (EMAIL_DRIVER=mailjet):
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# ─── OIDC / OAuth SSO (Authentik, Keycloak, Google, Okta, Entra ID, …) ──────
# Enables /api/auth/oidc/login + /callback when CLIENT_ID + the 3 URLs are set.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile

# ─── SAML 2.0 SSO (SP-initiated; enabled when entry point + issuer + cert set) ─
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_IDP_CERT=
SAML_CALLBACK_URL=

# ─── AI provider (optional; abstraction supports many) ──────────────────────
AI_PROVIDER=                  # openai | anthropic | google | ollama | openrouter | custom
AI_API_KEY=
AI_BASE_URL=
